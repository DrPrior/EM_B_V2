# Environment for the EM_B_Hybrid stack.
#
# Development: copy to `.env` and fill in a password. docker-compose.yml reads it.
# Desktop app: DO NOT hand-edit — the Electron app generates a per-install env
#   file with a random Neo4j password under its userData dir and passes it to
#   `docker compose --env-file <that file> -f docker-compose.desktop.yml`.
#
# Only NEO4J_AUTH and DB_URI are read by the app code (src/database/connection.py
# reads them via os.environ). The rest tune the container at runtime and match
# the defaults in src/core/config.py.

# --- Required by the containers ---
# Neo4j credentials in "user/password" form. The desktop app randomizes the
# password per install; never ship a real one.
NEO4J_AUTH=neo4j/change-me
# Bolt URL the API uses to reach Neo4j (service name inside the compose network).
DB_URI=bolt://neo4j:7687

# --- Desktop compose interpolation (docker-compose.desktop.yml) ---
# Prebuilt API image tag to run (matches the loaded tar). Defaults to "latest".
APP_VERSION=latest
# Absolute host path to the project_data corpus, mounted read-only into the API
# container at /app/project_data so citation download links resolve. The desktop
# app points this at its downloaded copy under userData.
PROJECT_DATA_DIR=./project_data

# --- Optional overrides (defaults live in src/core/config.py) ---
# Host-native Ollama endpoint. In containers this is host.docker.internal;
# override only if Ollama runs on a non-default host/port.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Custom Ollama variant names built by the bootstrap / wizard.
# CHAT_MODEL=chat-model
# EMBEDDING_MODEL=embedding-model
