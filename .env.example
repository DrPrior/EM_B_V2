# Environment for the EM_B_Hybrid app.
#
# Native dev (the decontainerized target — see docs/NATIVE_DEV.md):
#   copy to `.env`, fill in a password, point DATA_ROOT at your corpus, then run
#   scripts/dev-up.ps1 (loads this file and starts uvicorn). No Docker.
#
# The app reads these via src/core/config.py (pydantic-settings, case-insensitive)
# and src/database/connection.py (NEO4J_AUTH, DB_URI via os.environ).

# --- Required ---
# Neo4j credentials in "user/password" form. Must match the password the native
# Neo4j server was initialized with (neo4j-admin dbms set-initial-password).
NEO4J_AUTH=neo4j/change-me
# Bolt URL the API uses to reach Neo4j. Native: loopback. (Legacy Docker used the
# compose service name, bolt://neo4j:7687.)
DB_URI=bolt://127.0.0.1:7687

# --- Data root ---
# Absolute path to the project_data corpus. Used as BOTH the ingestion root and
# the base for /files citation download links, so the value you ingest with must
# be the value you serve with. Use FORWARD SLASHES even on Windows; the stored
# File.filepath is normalized to forward slashes to match.
#   Windows example: DATA_ROOT=C:/Users/seprior/EM_B_Hybrid/project_data
DATA_ROOT=./project_data

# --- Optional overrides (defaults live in src/core/config.py) ---
# Host-native Ollama endpoint. Native default is already http://localhost:11434,
# so this is only needed for a non-default host/port. (Legacy Docker overrode it
# to http://host.docker.internal:11434 — do NOT use that natively.)
# OLLAMA_BASE_URL=http://localhost:11434
# Logging. Unset LOG_DIR = console only (normal dev). Set it to write rotating
# api.log files there instead, with nothing on the console (what the packaged app
# does). LOG_LEVEL=DEBUG also logs user question text, so don't share DEBUG logs.
# LOG_DIR=C:/Users/seprior/EM_B_Hybrid/logs
# LOG_LEVEL=INFO
# Custom Ollama variant names built by the startup bootstrap.
# CHAT_MODEL=chat-model
# EMBEDDING_MODEL=embedding-model

# --- Legacy (Docker) — being removed, see docs/DECONTAINERIZE_PLAN.md ---
# The Docker desktop compose interpolated these; they are unused natively:
#   APP_VERSION=latest
#   PROJECT_DATA_DIR=./project_data
